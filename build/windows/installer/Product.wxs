<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v3 source for the PPPoEDialer MSI.

  The in-app updater falls back to this MSI when the install directory is not
  writable (see internal/update), so it must stay a per-machine install that
  only ever replaces the single EXE.

  Candle variables (passed on the command line):
    -dVersion=X.Y.Z         MSI ProductVersion; must be numeric only
    -dSrcDir=<path>         directory containing PPPoEDialer.exe
    -dIconPath=<file>       icon shown in Programs and Features
    -dLicensePath=<file>    RTF license text shown by the minimal UI
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <?define ProductName = "PPPoEDialer" ?>
  <?define Manufacturer = "Lexo0522" ?>

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="2052"
           Codepage="936"
           Version="$(var.Version)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="{8F6B2A41-5C3D-4E7A-9B12-6D0F4A7C2E31}">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Description="PPPoE 校园网拨号工具"
             Comments="PPPoE campus network dialer"
             Manufacturer="$(var.Manufacturer)"
             Languages="2052"
             SummaryCodepage="936"/>

    <!-- Always remove a previous version before installing this one. -->
    <MajorUpgrade Schedule="afterInstallValidate"
                  DowngradeErrorMessage="已安装了更高版本的 $(var.ProductName)。"/>

    <Media Id="1" Cabinet="app.cab" EmbedCab="yes"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)"/>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppProgramMenuFolder" Name="$(var.ProductName)"/>
      </Directory>
      <!-- Desktop 是 Windows Installer 的预定义目录 Id：安装期解析为当前
           用户自己的桌面（不是 All Users 桌面），不需要额外 DirectoryRef。 -->
      <Directory Id="DesktopFolder"/>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="{2D9E1C77-4A58-4F0B-8E63-1C7B5D9A0F42}">
        <File Id="PPPoEDialerExe"
              Name="PPPoEDialer.exe"
              Source="$(var.SrcDir)\PPPoEDialer.exe"
              KeyPath="yes"/>
        <!-- The binary was called PPoEDialer.exe before the rename; sweep it. -->
        <RemoveFile Id="LegacyExe" Name="PPoEDialer.exe" On="both"/>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="AppProgramMenuFolder">
      <Component Id="ApplicationShortcut" Guid="{5A3F8B29-7C64-4D1E-9A08-3E5B6C7D2F14}">
        <Shortcut Id="AppStartMenuShortcut"
                  Name="$(var.ProductName)"
                  Description="PPPoE 校园网拨号工具"
                  Target="[INSTALLFOLDER]PPPoEDialer.exe"
                  WorkingDirectory="INSTALLFOLDER"/>
        <RemoveFolder Id="CleanUpShortcut" Directory="AppProgramMenuFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
                       Key="Software\$(var.Manufacturer)\$(var.ProductName)"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!-- 桌面快捷方式独立成组件，由欢迎页的 ADDDESKTOP 复选框按需安装：
         勾选则创建，不勾则连空桌面都不留。卸载时随组件一起清除。
         这里刻意没有 RemoveFolder：AppProgramMenuFolder 是安装时自建的
         子目录，卸载该清掉；DesktopFolder 是系统目录，一条 RemoveFolder
         On="uninstall" 会在卸载时尝试删掉桌面本身。快捷方式自身的清理由
         MSI 的 Shortcut/RemoveFile 表负责，不需要也不能自己删目录。 -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{3F1A5C82-6B94-4E2D-8C71-2A9D4E6B0C58}">
        <Shortcut Id="AppDesktopShortcut"
                  Name="$(var.ProductName)"
                  Description="PPPoE 校园网拨号工具"
                  Target="[INSTALLFOLDER]PPPoEDialer.exe"
                  WorkingDirectory="INSTALLFOLDER"/>
        <RegistryValue Root="HKCU"
                       Key="Software\$(var.Manufacturer)\$(var.ProductName)"
                       Name="desktop_installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
        <Condition><![CDATA[ADDDESKTOP=1]]></Condition>
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="$(var.ProductName)" Level="1">
      <ComponentRef Id="MainExecutable"/>
      <ComponentRef Id="ApplicationShortcut"/>
      <ComponentRef Id="DesktopShortcut"/>
    </Feature>

    <!-- 欢迎页的两个选项。默认都勾上：对拨号工具而言桌面入口 + 装完即用是
         多数人的预期。

         这两个默认值只在「有人机交互的安装」下成立。应用内更新（internal/update
         的 writeMsiApplyScript）会显式传 SILENTUPDATE=1，并在 msiexec 上加 /qn，
         所以更新走的是完全静默的安装：UI 序列不运行，两个复选框根本不出现，
         这里的默认值也就无从被用户改掉。 -->
    <Property Id="ADDDESKTOP" Value="1"/>
    <Property Id="LAUNCHAPP" Value="1"/>

    <!-- 装完立即启动。自定义动作直接以 FileKey 指向安装后的 exe（MSI 原生的
         type 18 自定义操作），不引 WixUtilExtension——少一个链接期依赖，
         也不用给 light 加 -ext。
         Execute="deferred" 且排在 InstallFinalize 之前：此刻文件已就位、
         注册表项已提交，exe 一定是完整可执行的。（deferred 动作只能落在
         InstallInitialize..InstallFinalize 之间，排在 Finalize 之后过不了
         ICE77。）
         Return="ignore"：启动失败（被安全软件拦、权限异常等）绝不把整个
         安装判成失败，安装本身已经把活干完了。
         Impersonate="yes"：以当前用户身份启动（perMachine 安装下服务账号
         拉起桌面程序会落在错误的会话里）。

         为什么要 SILENTUPDATE 而不是 UILevel：msiexec /i 省略 /q 时 UI 级别
         是 MsiSetInternalUI 文档里的 DEFAULT，GUI 进程落到 FULL(5) 而非
         静默(2)，靠 UILevel<>2 拦不住应用内更新。而更新脚本自己会在装完
         重启应用，这里再拉一次只会和它打架、让用户以为更新卡住了，所以
         「是不是程序内更新」这件事只能由调用方显式告知：SILENTUPDATE=1。

         SILENTUPDATE 不出现在上面的 Property 表里：Property 表的 Value 列
         不允许空串，而这里只需要「命令行传了就是 1、没传就是空」这两种
         状态。未设置的属性在条件语法里求值为空串，NOT SILENTUPDATE=1
         自然成立；真要写一条空值 Property，candle 只会给个
         PropertyUseless 警告。 -->
    <CustomAction Id="LaunchApp"
                  FileKey="PPPoEDialerExe"
                  ExeCommand=""
                  Return="ignore"
                  Execute="deferred"
                  Impersonate="yes"/>

    <InstallExecuteSequence>
      <!-- 必须排在 InstallFinalize 之前：deferred 自定义动作只能出现在
           InstallInitialize..InstallFinalize 之间，排在 Finalize 之后 light
           的 ICE77 会报 "is a in-script custom action. It must be sequenced
           in between the InstallInitialize action and the InstallFinalize
           action"（历史上就是这么炸的）。
           此时 CopyFiles/Registry/ Commit 都已完成，exe 已就位，
           再以当前用户身份拉起程序。 -->
      <Custom Action="LaunchApp" Before="InstallFinalize"><![CDATA[LAUNCHAPP=1 AND NOT SILENTUPDATE=1 AND NOT Installed]]></Custom>
    </InstallExecuteSequence>

    <Property Id="ARPHELPLINK" Value="https://github.com/Lexo0522/one-key-dialer"/>
    <Property Id="ARPPRODUCTICON" Value="AppIcon"/>
    <Icon Id="AppIcon" SourceFile="$(var.IconPath)"/>

    <!-- Minimal-dialog UI (EULA page + progress + exit), no reboot prompts.
         Dialog text comes from WixUI_zh-CN.wxl via -cultures:zh-cn (see
         release.yml). WixUILicenseRtf is a BUILD-TIME WixVariable: the
         extension embeds the RTF into the Binary table at link time, the
         runtime property of the same name only carries the extracted file. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicensePath)"/>

    <!-- 不用 <UIRef Id="WixUI_Minimal"/>：本页要在 EULA 页上加两个复选框，
         而 WiX 不允许在产品里再声明一个同名 Dialog 去改扩展里的官方对话框
         ——light 链接期会判 Dialog 表主键，报
         LGHT0091 Duplicate symbol 'Dialog:WelcomeEulaDlg'（历史上就是这么
         炸的）。所以这里不引 WixUI_Minimal，改为引 WixUI_Common（只提供
         字体/UIText/位图二进制，不含任何对话框），再把首装序列用到的官方
         对话框逐个显式 DialogRef，最后自己写一页完整的欢迎页。

         需要显式引用的官方对话框，对应两条序列各自用到的：
           首装  ErrorDlg / FatalError / FilesInUse / MsiRMFilesInUse /
                 OutOfDiskDlg / OutOfRbDiskDlg / PrepareDlg / ProgressDlg /
                 UserExit / WaitForCostingDlg / CancelDlg / ExitDialog
           维护  MaintenanceWelcomeDlg / MaintenanceTypeDlg / VerifyReadyDlg
         首装页 Install 按钮的 Publish 目标是 OutOfDiskDlg / OutOfRbDiskDlg /
         WaitForCostingDlg，Cancel 目标是 CancelDlg，Print 目标是
         WixUIPrintEula（自定义动作，由 WixUI_Common 提供）。

         注意 DialogRef 必须放在 <UI> 里：直接挂在 Product 下 candle 会报
         CNDL0005 unexpected child element 'DialogRef'（Product 的子元素
         里没有 DialogRef）。

         TextStyle / DefaultUIFont 必须自己补：WixUI_Common 只提供 UIText 与
         Binary，不带字体表；这两个声明原本在 WixUI_Minimal 的 <UI> 里，
         去掉 UIRef 之后就没了，light 的 ICE31 会逐个控件报
         "uses text style WixUI_Font_XXX, but the TextStyle table does not
         exist"（WelcomePage / ProgressDlg / VerifyReadyDlg 等全中）。 -->
    <UI>
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="Minimal" />

      <UIRef Id="WixUI_Common"/>
      <DialogRef Id="CancelDlg"/>
      <DialogRef Id="ErrorDlg"/>
      <DialogRef Id="ExitDialog"/>
      <DialogRef Id="FatalError"/>
      <DialogRef Id="FilesInUse"/>
      <DialogRef Id="MaintenanceTypeDlg"/>
      <DialogRef Id="MaintenanceWelcomeDlg"/>
      <DialogRef Id="MsiRMFilesInUse"/>
      <DialogRef Id="OutOfDiskDlg"/>
      <DialogRef Id="OutOfRbDiskDlg"/>
      <DialogRef Id="PrepareDlg"/>
      <DialogRef Id="ProgressDlg"/>
      <DialogRef Id="UserExit"/>
      <DialogRef Id="VerifyReadyDlg"/>
      <DialogRef Id="WaitForCostingDlg"/>

      <!-- 自有的首装欢迎页。Id 与任何 wixlib 对话框都不重名，避免链接期判重。
           几何与控件行为照抄扩展的 WelcomeEulaDlg（Bitmap/Title/BottomLine/
           LicenseAcceptedCheckBox/Print/Back/Install/InstallNoShield/Cancel），
           只做两处改动：

           1. LicenseText 高度 162 → 116（Y=36..152），给两个新复选框腾位；
           2. 增加 AddDesktopCheckBox / LaunchAppCheckBox 两个复选框，
              放在 Y=157 / Y=182，行高 20，落在许可复选框（Y=207）上方的空档。

           复选框的 Property 直接驱动安装行为：ADDDESKTOP=1 才装桌面快捷方式
           组件（见 DesktopShortcut 的 Condition），LAUNCHAPP=1 才触发
           LaunchApp 自定义动作（见 InstallExecuteSequence）。 -->
      <Dialog Id="WelcomePage" Width="370" Height="270" Title="!(loc.WelcomeEulaDlg_Title)">
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.WelcomeEulaDlgBitmap)" />
        <Control Id="Title" Type="Text" X="130" Y="6" Width="225" Height="30" Transparent="yes" NoPrefix="yes" Text="!(loc.WelcomeEulaDlgTitle)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="LicenseText" Type="ScrollableText" X="130" Y="36" Width="226" Height="116" Sunken="yes" TabSkip="no">
          <Text SourceFile="!(wix.WixUILicenseRtf=$(var.LicensePath))"/>
        </Control>
        <Control Id="AddDesktopCheckBox"
                 Type="CheckBox"
                 X="130" Y="157"
                 Width="226" Height="20"
                 Property="ADDDESKTOP"
                 CheckBoxValue="1"
                 Text="创建桌面快捷方式"/>
        <Control Id="LaunchAppCheckBox"
                 Type="CheckBox"
                 X="130" Y="182"
                 Width="226" Height="20"
                 Property="LAUNCHAPP"
                 CheckBoxValue="1"
                 Text="立即启动应用"/>
        <Control Id="LicenseAcceptedCheckBox" Type="CheckBox" X="130" Y="207" Width="226" Height="18" CheckBoxValue="1" Property="LicenseAccepted" Text="!(loc.WelcomeEulaDlgLicenseAcceptedCheckBox)" />
        <Control Id="Print" Type="PushButton" X="88" Y="243" Width="56" Height="17" Text="!(loc.WixUIPrint)">
          <Publish Event="DoAction" Value="WixUIPrintEula">1</Publish>
        </Control>
        <Control Id="Back" Type="PushButton" X="156" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="Install" Type="PushButton" ElevationShield="yes" X="212" Y="243" Width="80" Height="17" Default="yes" Text="!(loc.WelcomeEulaDlgInstall)" Hidden="yes">
          <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg">!(wix.WixUICostingPopupOptOut) OR CostingComplete = 1</Publish>
          <Publish Event="EndDialog" Value="Return"><![CDATA[OutOfDiskSpace <> 1]]></Publish>
          <Publish Event="SpawnDialog" Value="OutOfRbDiskDlg">OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST="P" OR NOT PROMPTROLLBACKCOST)</Publish>
          <Publish Event="EndDialog" Value="Return">OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST="D"</Publish>
          <Publish Event="EnableRollback" Value="False">OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST="D"</Publish>
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg">(OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST="F")</Publish>
          <Condition Action="disable"><![CDATA[LicenseAccepted <> "1"]]></Condition>
          <Condition Action="enable">LicenseAccepted = "1"</Condition>
          <Condition Action="show">ALLUSERS</Condition>
        </Control>
        <Control Id="InstallNoShield" Type="PushButton" ElevationShield="no" X="212" Y="243" Width="80" Height="17" Default="yes" Text="!(loc.WelcomeEulaDlgInstall)" Hidden="yes">
          <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg">!(wix.WixUICostingPopupOptOut) OR CostingComplete = 1</Publish>
          <Publish Event="EndDialog" Value="Return"><![CDATA[OutOfDiskSpace <> 1]]></Publish>
          <Publish Event="SpawnDialog" Value="OutOfRbDiskDlg">OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST="P" OR NOT PROMPTROLLBACKCOST)</Publish>
          <Publish Event="EndDialog" Value="Return">OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST="D"</Publish>
          <Publish Event="EnableRollback" Value="False">OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST="D"</Publish>
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg">(OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST="F")</Publish>
          <Condition Action="disable"><![CDATA[LicenseAccepted <> "1"]]></Condition>
          <Condition Action="enable">LicenseAccepted = "1"</Condition>
          <Condition Action="show">NOT ALLUSERS</Condition>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <!-- 序列入口。Show 放在 Product/InstallUISequence 里（与 Product 已有的
           LaunchApp 那条 InstallExecuteSequence 平级，是 WiX 规定的执行序列
           位置）；Publish 放不进去——它是 UI/的子元素，直接写在这里 candle
           会报 CNDL0004（Publish 上没有 Dialog/Control/Event/Value）。
           官方扩展（WixUI_Advanced/Mondo/Monimal）的写法就是
           <UI><Publish .../></UI> 与 Product/InstallUISequence/<Show> 分开，
           这里照此办理。

           ProgressDlg 与 PrepareDlg 自己会在 InstallUISequence 的固定位置
           无条件 Show（Before="ExecuteAction" / Before="AppSearch"），所以
           欢迎页只要把用户带到 ExecuteAction 即可：Install/InstallNoShield
           的 EndDialog@Return 会结束 UI 序列并进入执行序列，不需要额外的
           Publish。

           维护安装（已装过）的入口：WixUI_Minimal 原本只处理首装与补丁，不处理
           maintenance-install；这里补一条与 WixUI_Advanced 相同的序列，
           修复「重装/卸载没有 UI、直接静默执行」的行为。 -->
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
      <!-- 官方对话框里这两个按钮在 wixlib 中没有事件，原本由 WixUI_Minimal /
           WixUI_Advanced 的 Publish 补上。去掉 UIRef 后要自己补，否则 light
           的 ICE17 报 "does not have an event defined in the ControlEvent
           table. It is a 'Do Nothing' button." -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2">Installed AND NOT PATCH</Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>
    </UI>

    <InstallUISequence>
      <Show Dialog="WelcomePage" Before="ProgressDlg">NOT Installed</Show>
      <Show Dialog="MaintenanceWelcomeDlg" Before="ProgressDlg">Installed</Show>
    </InstallUISequence>
  </Product>
</Wix>
